<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.esri.arcgisruntime.mapping.view.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 顶部工具栏 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/surface_deep"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索 POI..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="6dp"
                android:textColor="@color/accent_mint"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:padding="12dp"
                android:contentDescription="@string/cd_clear_search"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_close"
                app:tint="@color/text_hint" />

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/surface_mid" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@null"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="图层"
                android:contentDescription="@string/cd_layers"
                android:textColor="@color/accent_mint"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBasemap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@null"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="地形图"
                android:contentDescription="@string/cd_basemap"
                android:textColor="@color/accent_mint"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 缩放按钮（右侧居中） -->
    <LinearLayout
        android:id="@+id/zoomContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mapView">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/zoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_zoom_button"
            android:elevation="4dp"
            android:padding="0dp"
            android:text="+"
            android:contentDescription="@string/cd_zoom_in"
            android:textColor="@color/accent_mint"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/zoomOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_zoom_button"
            android:elevation="4dp"
            android:padding="0dp"
            android:text="−"
            android:contentDescription="@string/cd_zoom_out"
            android:textColor="@color/accent_mint"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_zoom_button"
            android:elevation="4dp"
            android:padding="12dp"
            android:contentDescription="@string/cd_home"
            app:srcCompat="@drawable/ic_home_nav"
            app:tint="@color/accent_mint" />

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStats"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_zoom_button"
            android:elevation="4dp"
            android:padding="0dp"
            android:text="统"
            android:contentDescription="@string/cd_stats"
            android:textColor="@color/accent_mint"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 图层控制面板（默认隐藏，点击"图层"按钮展开） -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layerPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/surface_deep"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 可点击标题栏 -->
            <LinearLayout
                android:id="@+id/layerHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@color/accent_mint">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="图层控制"
                    android:textColor="@color/surface_deep"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textSize="11sp"
                    android:textColor="@color/surface_deep" />

            </LinearLayout>

            <!-- 图层行由 setupLayerPanel() 动态生成 -->
            <LinearLayout
                android:id="@+id/checkboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 查询加载指示器（居中浮于地图上） -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loadingCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/surface_deep"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:padding="14dp"
            app:indicatorColor="@color/accent_mint"
            app:trackColor="@color/surface_mid"
            app:indicatorSize="40dp"
            app:trackThickness="4dp" />

    </androidx.cardview.widget.CardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="@string/cd_my_location"
        app:backgroundTint="@color/accent_mint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="@color/surface_deep" />

</androidx.constraintlayout.widget.ConstraintLayout>
